# Security boundary for the workspace-aware dashboard Dockerfiles.
# Deny everything, then allow only inputs required by their COPY/build steps.
**

!package.json
!package-lock.json

!packages/
packages/*
!packages/tsconfig.base.json
!packages/packages/
packages/packages/*
!packages/packages/shared-constants/
packages/packages/shared-constants/*
!packages/packages/shared-constants/package.json
!packages/packages/shared-constants/tsconfig.json
!packages/packages/shared-constants/src/
!packages/packages/shared-constants/src/**
!packages/packages/shared-types/
packages/packages/shared-types/*
!packages/packages/shared-types/package.json
!packages/packages/shared-types/tsconfig.json
!packages/packages/shared-types/src/
!packages/packages/shared-types/src/**
!packages/packages/shared-utils/
packages/packages/shared-utils/*
!packages/packages/shared-utils/package.json
!packages/packages/shared-utils/tsconfig.json
!packages/packages/shared-utils/src/
!packages/packages/shared-utils/src/**
!packages/packages/shared-services/
packages/packages/shared-services/*
!packages/packages/shared-services/package.json
!packages/packages/shared-services/tsconfig.json
!packages/packages/shared-services/src/
!packages/packages/shared-services/src/**

!dashboard/
dashboard/*
!dashboard/package.json
!dashboard/index.html
!dashboard/tsconfig.json
!dashboard/tsconfig.app.json
!dashboard/tsconfig.node.json
!dashboard/vite.config.ts
!dashboard/tailwind.config.ts
!dashboard/playwright.config.ts
!dashboard/src/
!dashboard/src/**
!dashboard/public/
!dashboard/public/**
!dashboard/tests/
dashboard/tests/*
!dashboard/tests/smoke/
!dashboard/tests/smoke/**
!dashboard/.deployment/
dashboard/.deployment/*
!dashboard/.deployment/Dockerfile.dev
!dashboard/.deployment/Dockerfile.prod
!dashboard/.deployment/nginx/
dashboard/.deployment/nginx/*
!dashboard/.deployment/nginx/default.conf

# Defense in depth: these must stay excluded even if an allowlist expands later.
**/.env
**/.env.*
**/*.env
**/.git
**/.git/**
**/.claude
**/.claude/**
**/node_modules
**/node_modules/**
**/.terraform
**/.terraform/**
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/dist
**/dist/**
**/build
**/build/**
**/coverage
**/coverage/**
**/playwright-report
**/playwright-report/**
**/test-results
**/test-results/**
**/*.tsbuildinfo
**/*.log
**/.DS_Store
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*.json
**/*secrets*
**/*.zip
