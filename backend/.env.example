# Ledova backend environment template.
# Copy to `.env`, keep it local, and replace only the values needed for the
# feature you are running. Blank integration values are intentionally
# nonfunctional; configure a complete integration before invoking it.

# --- Django core (required for startup) ---
SECRET_KEY=
DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174
# Must list the dashboard origin: its cookie-authenticated POST/PUT/PATCH/DELETE
# requests carry a CSRF token that Django only accepts from a trusted origin.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5174
LEDOVA_ADMIN_BASE_URL=http://localhost:5174/admin
PUBLIC_API_BASE_URL=http://localhost:8000
# Display name of the operator row created on first use (Django admin > Operator); blank = "Ledova operator".
OPERATOR_NAME=

# --- Auth cookies / tokens ---
# COOKIE_DOMAIN also scopes the readable `csrftoken` cookie; leave it empty for
# localhost (cookies ignore ports) and set it to the shared parent domain when the
# dashboard and the API are on different subdomains.
COOKIE_DOMAIN=
COOKIE_ACCESS_NAME=access
COOKIE_REFRESH_NAME=refresh
COOKIE_SECURE=false
# Both default to 7 days. The access token is bound to its refresh session (`rjti`),
# checked on every request, so a long access lifetime does not delay revocation.
ACCESS_TOKEN_LIFETIME=604800
REFRESH_TOKEN_LIFETIME=604800

# --- Database (required for database-backed features) ---
POSTGRES_DB=ledova
POSTGRES_USER=ledova
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# --- Redis / background work ---
REDIS_URL=redis://localhost:6379/0

# --- Blockchain (local node by default; deployment addresses are optional) ---
# JSON-RPC endpoint; use http://localhost:8545 when the backend runs outside Docker against `npx hardhat node`.
BLOCKCHAIN_RPC_URL=http://host.docker.internal:8545
# Chain id the endpoint must report (31337 = local Hardhat node, 84532 = Base Sepolia); anything else is refused.
BLOCKCHAIN_CHAIN_ID=31337
ETHEREUM_CHAIN_ID=11155111
BITCOIN_NETWORK=test
# Operator key: owns the factory, registry, AtomicSwap and every share token; Hardhat account #0 is
# 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 (public, local use only).
BLOCKCHAIN_OPERATOR_KEY=
# The four addresses `npm run deploy:local:core` writes to .deployed-contracts.env at the repository root.
# WhitelistRegistry: investors must be on it before any share token can be minted or transferred to them.
WHITELIST_CONTRACT_ADDRESS=
# ShareTokenFactory: createShareToken / getTokenByIdentifier, keyed by "<acn>:<symbol>" (one token per share class).
SHARE_TOKEN_FACTORY_ADDRESS=
# AtomicSwap: new share tokens are approved for settlement here after deployment.
ATOMIC_SWAP_ADDRESS=
# AUDY stablecoin used as the payment token.
STABLECOIN_CONTRACT_ADDRESS=
# Fetch ERC-20 transfer history for verified EVM wallets from the RPC provider (off by default; without it EVM
# holdings only appear from app-initiated transfers).
EVM_ASSET_TRANSFER_HISTORY_ENABLED=false
SWAP_ORDER_EXPIRY_HOURS=24

# --- Media storage ---
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-southeast-2
GS_BUCKET_NAME=

# --- Pricing / public testnet data providers ---
ALCHEMY_ETH_URL=
ALCHEMY_BTC_URL=
ALCHEMY_BASE_URL=
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BLOCKSTREAM_API_URL=https://blockstream.info/testnet/api

# --- KYC providers (optional; disabled until explicitly configured) ---
KYC_PROVIDER=
KYCAID_API_TOKEN=
KYCAID_BASE_URL=
KYCAID_FORM_ID=
SUMSUB_API_KEY=
SUMSUB_SECRET_KEY=
SUMSUB_BASE_URL=
SUMSUB_WEBHOOK_SECRET=

# --- Email ---
# With SENDGRID_API_KEY empty, mail (including the sign-up verification code) is
# printed to the backend log in DEBUG and sent to local SMTP otherwise.
DEFAULT_FROM_EMAIL=noreply@localhost
SENDGRID_API_KEY=
SENDGRID_API_URL=

# --- On/off-ramp (optional; disabled until explicitly configured) ---
TRANSAK_API_KEY=
TRANSAK_API_SECRET=
TRANSAK_API_URL=
TRANSAK_API_GATEWAY_URL=
TRANSAK_REFERRER_DOMAIN=localhost

# --- Local/private LLM extraction (optional) ---
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5vl:7b
