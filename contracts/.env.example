# Ledova Hardhat configuration.
# Compilation and local tests do not require secrets. Keep deployment values
# blank until an explicitly approved testnet deployment.
# Hardhat reads `process.env`; export approved values in the deployment shell.

DEPLOYER_PRIVATE_KEY=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional explorer and reporting settings.
ETHERSCAN_API_KEY=
# REPORT_GAS=1

# Script-specific existing deployment addresses. Never commit real private keys.
FACTORY_ADDRESS=
WHITELIST_ADDRESS=
STABLECOIN_ADDRESS=
SHARE_TOKEN_ADDRESS=
RELAYER_ADDRESS=

# Optional sample-token settings used by deploy-share-token.ts.
# Leave blank to use the script's synthetic defaults.
TOKEN_NAME=
TOKEN_SYMBOL=
COMPANY_IDENTIFIER=
AUTHORIZED_SHARES=
INITIAL_MINT=
