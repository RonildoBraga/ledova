# Build stage. No cloud provider or architecture is assumed.
FROM node:22.15.1-alpine AS build

RUN npm install -g npm@11.5.2

# Set the working directory
WORKDIR /usr/src/app

# Copy root workspace files
COPY package.json package-lock.json ./
COPY packages ./packages
COPY dashboard ./dashboard

# Install dependencies (workspace mode - no NPM_TOKEN needed)
RUN npm ci

# Vite embeds public endpoints at build time. Keep mode-specific .env files out
# of the Docker context and pass explicit, non-secret values instead.
ARG VITE_API_URL=http://localhost:8000
ARG VITE_MARKETING_URL=http://localhost:5173
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_MARKETING_URL=${VITE_MARKETING_URL}

# Build the dashboard application
WORKDIR /usr/src/app/dashboard
RUN npm run build

# Static-serving stage.
FROM nginx:stable-alpine AS production

# Copy built assets from build stage
COPY --from=build /usr/src/app/dashboard/dist /usr/share/nginx/html

# Copy custom nginx config
COPY dashboard/.deployment/nginx/default.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
