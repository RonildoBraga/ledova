# Ledova dashboard — environment template. Copy to `.env` and edit.
# Vite exposes only variables prefixed with VITE_ to the client bundle.
VITE_API_URL=http://localhost:8000
VITE_LEDOVA_URL=http://localhost:5174
VITE_MARKETING_URL=http://localhost:5173
VITE_HOST=0.0.0.0
VITE_PORT=5174
VITE_ALLOWED_HOSTS=localhost,127.0.0.1
