# Ledova mobile (Expo) — environment template. Copy to `.env` and edit.
# EXPO_PUBLIC_ variables are embedded in the client build.
# iOS simulator: localhost. Android emulator: replace localhost with 10.0.2.2.
# Physical device: use the development host's LAN address and keep this file local.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_USE_MOCK_DATA=false
EXPO_PUBLIC_MARKETING_URL=http://localhost:5173
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_APP_STORE_URL=
