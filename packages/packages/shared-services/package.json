{
  "name": "@ledova/shared-services",
  "version": "10.1.518",
  "private": true,
  "description": "Platform-agnostic API services with pure functions and dependency injection. Includes auth, portfolios, assets, countries, sectors, and more.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@ledova/shared-constants": "^8.15.543",
    "@ledova/shared-types": "^8.22.518",
    "@ledova/shared-utils": "^8.23.518",
    "axios": "^1.9.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "functional-programming",
    "dependency-injection",
    "typescript",
    "api-client",
    "authentication",
    "portfolio",
    "services",
    "pure-functions"
  ],
  "author": "Ledova Team",
  "license": "Apache-2.0"
}
