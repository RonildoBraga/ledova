{
  "name": "@ledova/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared constants, types, API services and utilities for the Ledova clients (consumed from source, no build step)",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^19",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tanstack/react-query": "^5.102.8",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  }
}
